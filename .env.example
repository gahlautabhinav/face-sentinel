DB_URL=jdbc:postgresql://localhost:5435/logbook360_face
DB_USERNAME=postgres
DB_PASSWORD=changeme

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=logbook360-face-dev
REKOGNITION_COLLECTION_PREFIX=logbook360-dev
REKOGNITION_SIMILARITY_THRESHOLD=90.0
REKOGNITION_MIN_FACE_COVERAGE=0.10
REKOGNITION_MAX_CENTER_OFFSET=0.25

FACE_LIVENESS_ENABLED=false
REKOGNITION_LIVENESS_CONFIDENCE_THRESHOLD=80.0

# JWT Auth (Phase 3)
# Generate JWT_SECRET: any random string >= 32 chars
# PowerShell: -join ((65..90)+(97..122)+(48..57) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=changeme-jwt-secret-replace-with-random-48-char-string
JWT_EXPIRY_HOURS=24
ADMIN_CLIENT_ID=logbook360-admin
ADMIN_CLIENT_SECRET=changeme-admin-secret
KIOSK_CLIENT_ID=logbook360-kiosk
KIOSK_CLIENT_SECRET=changeme-kiosk-secret
